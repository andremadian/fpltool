SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional dead-man switch pings (healthchecks.io). Create one check per
# schedule, paste its ping URL here. Engines ping on every run (a /fail
# suffix on failure); healthchecks emails you when a ping DOESN'T arrive.
# Leave unset to disable.
HEALTHCHECK_URL_WEEKLY=
HEALTHCHECK_URL_DAILY=
HEALTHCHECK_URL_USER=

# Weekly heartbeat delivery (health_check.py --notify, Thursday 8pm WIB).
# 1. Message @BotFather on Telegram, /newbot, copy the token below.
# 2. Send your new bot any message, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy result[0].message.chat.id
# Leave unset to disable --notify (the report still prints).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
